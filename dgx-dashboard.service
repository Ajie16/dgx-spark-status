[Unit]
Description=DGX Spark Status Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xujie
WorkingDirectory=/home/xujie/workspace/dgx-spark-status
ExecStart=/home/xujie/tools/nodejs/node-v24.19.0-linux-arm64/bin/node dev-server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
